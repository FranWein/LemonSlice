---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import FirstBox from "../components/FirstBox.astro";
import WaveDivider from "../components/WaveDivider.astro";
import SecondPart from "../components/SecondPart.astro";
import OurProducts from "../components/OurProducts.astro";
import WhiteWave from "../components/WhiteWave.astro";
import lemonImg from "../../public/img/lemon-img.png";
import FinalSec from "../components/FinalSec.astro";
---

<Layout>
    <NavBar />
    <img src={lemonImg.src} alt="Lemon" class="absolute h-110 mt-10 animate -ml-68"/>
    <FirstBox />
    <WaveDivider />
    <SecondPart />
    <WhiteWave />
    <OurProducts />
    <FinalSec />
</Layout>