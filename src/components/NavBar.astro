<header class="flex items-center gap-20 px-8 py-3.5 bg-[#FFF9E9]">
    <img src="./img/horizontalLogo.png" alt="Logo" class="w-25">

    <nav class="flex items-center gap-10">
        <p class="text-[#F1C500] txt hovered cursor-pointer btn" data-target="store">Tienda</p>
        <p class="text-[#F1C500] txt hovered cursor-pointer btn" data-target="explore">Explorar</p>
        <p class="text-[#F1C500] txt hovered cursor-pointer btn" data-target="business">Negocios</p>
    </nav>
</header>
<script>
    const buttons = document.querySelectorAll(".btn");

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const targetId = button.dataset.target;
            const target = document.getElementById(targetId);

            target?.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
            if (targetId === "business") {
                const lemon = document.querySelector("#lemon");
                if (lemon) {
                    lemon.classList.remove("lemon");
                    void lemon.offsetWidth;
                    lemon.classList.add("lemon");
                }
            }
        });
    });
</script>